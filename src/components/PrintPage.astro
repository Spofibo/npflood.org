---
type Props = {
   label: string;
};

const { label } = Astro.props;
---

<p class="no-print">
   <button type="button" class="btn btn--quiet" data-print-page>{label}</button>
</p>
<script>
   document.querySelectorAll("[data-print-page]").forEach((button) => {
      button.addEventListener("click", () => {
         window.print();
      });
   });
</script>
