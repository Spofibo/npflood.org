---
import PhoneDial from "../components/PhoneDial.astro";
import PrintPage from "../components/PrintPage.astro";
import { nepalEmergencyIds } from "../config/phones";
import { site } from "../config/site";
import Layout from "../layouts/Layout.astro";
import { formatVerifiedNpt } from "../lib/date";
import { chromeCopy, localeFromPathname, localePath, pagesCopy, paperCopy } from "../lib/i18n";

const locale = localeFromPathname(Astro.url.pathname, Astro.currentLocale);
const pages = pagesCopy(locale);
const chrome = chromeCopy(locale);
const page = pages.status;
const homePath = localePath(locale, "/");
const here = localePath(locale, page.path);
const verified = `${chrome.lastVerified} ${formatVerifiedNpt(site.builtAt, paperCopy(locale).months)}`;
---

<Layout
   title={page.title}
   description={page.description}
   path={page.path}
   breadcrumbs={[
      { name: "npflood.org", path: homePath },
      { name: chrome.nav.status, path: here },
   ]}
   includeWebsiteJsonLd={false}
   contactPoints={[
      { name: pages.phones.police, telephone: "100" },
      { name: pages.phones.fire, telephone: "101" },
      { name: pages.phones.ambulance, telephone: "102" },
      { name: pages.phones.bipad, telephone: "1234" },
      { name: pages.phones.neoc, telephone: "1149" },
   ]}
   faq={null}
   printScriptFonts={false}
>
   <h1 class="shiro">{chrome.nav.status}</h1>
   <div class="lede">
      <p>{page.lede}</p>
   </div>
   <PrintPage label={chrome.print} />
   <div class="banner banner--warn">
      <p>{pages.statusHazard}</p>
   </div>
   {pages.statusBody.map((block) => <p>{block}</p>)}
   <p>
      <a href={localePath(locale, "/danger/")}>{pages.statusChinaLink}</a>
   </p>
   <div class="dial-list">
      {nepalEmergencyIds.map((id) => <PhoneDial id={id} />)}
   </div>
   <section class="waiting stack" aria-label={pages.statusWaiting}>
      <h2 class="tile-title">{pages.statusWaiting}</h2>
      {
         pages.statusHeld.map((slot) => (
            <div class="held-slot stack">
               <h3 class="tile-title">{slot.title}</h3>
               <p>{slot.body}</p>
            </div>
         ))
      }
      <p>{verified}</p>
   </section>
</Layout>
