---
import NoscriptFields from "../components/NoscriptFields.astro";
import { closedDestination } from "../config/destinations";
import { safeFields } from "../config/safe-fields";
import Layout from "../layouts/Layout.astro";
import { fieldsCopy, formCopy, localeFromPathname, localePath, pagesCopy, paperCopy } from "../lib/i18n";
import { noscriptFieldLines } from "../lib/noscript-fields";

const locale = localeFromPathname(Astro.url.pathname, Astro.currentLocale);
const pages = pagesCopy(locale);
const form = formCopy(locale);
const fields = fieldsCopy(locale);
const paper = paperCopy(locale);
const page = pages.safe;
const homePath = localePath(locale, "/");
const here = localePath(locale, page.path);
---

<Layout
   title={page.title}
   description={page.description}
   path={page.path}
   breadcrumbs={[
      { name: "npflood.org", path: homePath },
      { name: paper.safeTitle, path: here },
   ]}
   includeWebsiteJsonLd={false}
   contactPoints={null}
   faq={null}
   printScriptFonts={true}
>
   <h1 class="shiro">{paper.safeTitle}</h1>
   <div class="lede">
      <p>{page.lede}</p>
   </div>
   <NoscriptFields
      intro={form.noscript}
      assembleNote={form.noscriptAssemble}
      lines={noscriptFieldLines(safeFields, fields)}
      groups={[]}
      statusHref={localePath(locale, "/status/")}
      statusLabel={form.statusLink}
      dangerHref={localePath(locale, "/danger/")}
      dangerLabel={form.dangerLink}
      showStatus={true}
      showDanger={true}
   />
   <script
      id="safe-config"
      type="application/json"
      set:html={JSON.stringify({ destination: closedDestination, form, fields: { safe: fields.safe }, paper })}
   />
   <div id="safe-app" class="stack"></div>
   <script src="../scripts/safe-client.ts"></script>
</Layout>
