---
import { trekDestination } from "../config/destinations";
import Layout from "../layouts/Layout.astro";
import { fieldsCopy, formCopy, localeFromPathname, localePath, pagesCopy } from "../lib/i18n";

const locale = localeFromPathname(Astro.url.pathname, Astro.currentLocale);
const pages = pagesCopy(locale);
const form = formCopy(locale);
const fields = fieldsCopy(locale);
const page = pages.trek;
const homePath = localePath(locale, "/");
const here = localePath(locale, page.path);
---

<Layout
	title={page.title}
	description={page.description}
	path={page.path}
	breadcrumbs={[
		{ name: "npflood.org", path: homePath },
		{ name: page.h1, path: here },
	]}
	includeWebsiteJsonLd={false}
	contactPoints={null}
	faq={null}
	guessRedirect={false}
>
	<h1 class="shiro">{page.h1}</h1>
	<div class="lede">
		<p>{page.lede}</p>
	</div>
	<aside class="note">
		<p>{pages.trekGuidance}</p>
	</aside>
	<noscript>
		<div class="note">
			<p>{form.noscript}</p>
			<p>
				<a href={localePath(locale, "/status/")}>{form.statusLink}</a>
			</p>
		</div>
	</noscript>
	<script
		id="trek-config"
		type="application/json"
		set:html={JSON.stringify({ destination: trekDestination, form, fields: { trek: fields.trek } })}
	/>
	<div id="trek-app" class="stack"></div>
	<script src="../scripts/trek-client.ts"></script>
</Layout>
